# CivicSense AI - Supabase Environment Configuration Template
# Copy this file as '.env.local' and provide your project credentials.
# Do NOT commit your actual .env.local file to version control.

# Supabase Project URL (found in Project Settings -> API)
# Example: https://xyzcompany.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable / Anon API Key (found in Project Settings -> API)
# WARNING: NEVER use service-role or secret keys in frontend client code.
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key-here

